{
  "name": "tailcat-tui-with-opentui",
  "version": "0.1.0",
  "description": "Tailcat TUI with OpenTUI and Cordis Micro-Kernel",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tailcat-tui": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "node --test tests/*.test.mjs",
    "test:simulation": "node --test tests/simulation.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:screenshots": "npm run build && node --test tests/e2e/*.test.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cordis": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
