FROM golang:1.24-alpine AS builder

ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY tailcat/go.mod tailcat/go.sum ./
RUN go mod download
COPY tailcat/ ./
COPY docker/derper/main.go ./cmd/derper/main.go
RUN CGO_ENABLED=0 go build -o /bin/derper ./cmd/derper

FROM alpine:3.21
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /bin/derper /usr/local/bin/derper
EXPOSE 3340 3478/udp
ENTRYPOINT ["/usr/local/bin/derper"]
